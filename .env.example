# Backend
PORT_BACKEND=11110
DB_PATH=/home/khuchinque/0-TRADER-COMPANEY/apps/engine/data/ledger.db
JWT_SECRET=your-secret-key-here-change-in-production
JWT_TTL=43200000
CORS_ORIGINS=http://localhost:22220
API_INTERNAL_URL=http://localhost:11110

# Terminal
PORT_TERMINAL=22220
ENGINE_REWRITE_URL=http://localhost:11110

# Auth
REQUIRE_PHONE_VERIFY=false
AUTO_ACTIVATE=true
ALLOW_ADMIN_ON_CUSTOMER_LOGIN=true

# Seed (change these!)
SEED_ADMIN_EMAIL=chinque@dev.local
SEED_ADMIN_PASSWORD=TestTrader2026!
SEED_CUSTOMER_EMAIL=customer@dev.local
SEED_CUSTOMER_PASSWORD=Customer2026!

# Trading
STARTING_BALANCE_USDT=10000
FAUCET_AMOUNT=1000
FAUCET_COOLDOWN_HOURS=24
MARKETS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
PRICE_SOURCE=sim
FEE_BPS=10
SPREAD_BPS=5

# Indodax FX Rate (IDR display toggle)
INDODAX_BASE_URL=https://indodax.com
FX_SOURCE=indodax
FX_TTL_MS=60000
FX_STALE_MAX_MS=300000
# ── Member accounts (apps/backend) ────────────────────────────────────────────
# Simulated starting funds granted on self-registration.
# MEMBER_START_USDT=10000
# Minimum member password length.
# MEMBER_MIN_PASSWORD=8
# Member session lifetime (default 30 days) and failed-login throttle.
# MEMBER_SESSION_TTL_MS=2592000000
# MEMBER_LOGIN_MAX_ATTEMPTS=10
# MEMBER_LOGIN_WINDOW_MS=900000

# ── Admin console (apps/backend) ──────────────────────────────────────────────
# CHANGE THESE BEFORE EXPOSING THE SERVICE. The boot log warns while the defaults
# are in use. ADMIN_PASSWORD is the single operator password for /admin.
# ADMIN_PASSWORD=admin1
# ADMIN_EMAIL=admin@chinque.local
# ADMIN_SESSION_TTL_MS=43200000
# ADMIN_LOGIN_MAX_ATTEMPTS=8
# ADMIN_LOGIN_WINDOW_MS=900000

# ── Session signing ───────────────────────────────────────────────────────────
# Set a long random value. Defaults to a development placeholder.
# JWT_SECRET=change-me-to-a-long-random-string

# ── Read-only market client (packages/market-client) ──────────────────────────
# MARKET_CLIENT_BASE_URL=http://127.0.0.1:22221
# MARKET_CLIENT_MIN_INTERVAL_MS=1000
# MARKET_CLIENT_TIMEOUT_MS=8000
