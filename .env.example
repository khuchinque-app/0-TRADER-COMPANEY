# Backend
PORT_BACKEND=11110
DB_PATH=/home/khuchinque/0-TRADER-COMPANEY/apps/engine/data/ledger.db
JWT_SECRET=your-secret-key-here-change-in-production
JWT_TTL=43200000
CORS_ORIGINS=http://localhost:22220
API_INTERNAL_URL=http://localhost:11110

# Terminal
PORT_TERMINAL=22220
ENGINE_REWRITE_URL=http://localhost:11110

# Auth
REQUIRE_PHONE_VERIFY=false
AUTO_ACTIVATE=true
ALLOW_ADMIN_ON_CUSTOMER_LOGIN=true

# Seed (change these!)
SEED_ADMIN_EMAIL=chinque@dev.local
SEED_ADMIN_PASSWORD=TestTrader2026!
SEED_CUSTOMER_EMAIL=customer@dev.local
SEED_CUSTOMER_PASSWORD=Customer2026!

# Trading
STARTING_BALANCE_USDT=10000
FAUCET_AMOUNT=1000
FAUCET_COOLDOWN_HOURS=24
MARKETS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
PRICE_SOURCE=sim
FEE_BPS=10
SPREAD_BPS=5

# Indodax FX Rate (IDR display toggle)
INDODAX_BASE_URL=https://indodax.com
FX_SOURCE=indodax
FX_TTL_MS=60000
FX_STALE_MAX_MS=300000

# Exchange frontend (apps/exchange, SPA on :22221)
PORT_EXCHANGE=22221
EXCHANGE_COOKIE_NAME=sx_exchange_session

# HollaEx Kit adapter (SERVER-SIDE ONLY — never expose to the browser bundle)
# Base REST URL of the Kit, e.g. http://localhost:10010/v2
HOLLAEX_API_URL=http://localhost:10010/v2
HOLLAEX_WS_URL=ws://localhost:10010/stream
# Public endpoints need no auth; set these only for authorized (order/wallet) calls.
HOLLAEX_API_KEY=
HOLLAEX_API_SECRET=
# Adapter tuning
HOLLAEX_TIMEOUT_MS=4000
HOLLAEX_CACHE_TTL_MS=2000
HOLLAEX_STALE_MAX_MS=300000
HOLLAEX_MIN_INTERVAL_MS=1000
