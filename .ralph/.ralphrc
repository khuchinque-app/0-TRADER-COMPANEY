# Ralph Configuration - 0-TRADER-COMPANEY
# See docs/user-guide/02-understanding-ralph-files.md for options

PROJECT_NAME="0-TRADER-COMPANEY"
PROJECT_TYPE="typescript"
MAX_CALLS_PER_HOUR=100
MAX_TOKENS_PER_HOUR=0
CLAUDE_TIMEOUT_MINUTES=15
CLAUDE_OUTPUT_FORMAT=json
CLAUDE_ALLOWED_TOOLS=Write,Read,Edit,MultiEdit,Glob,Grep,Task,TodoWrite,Bash(git *),Bash(npm *),Bash(python *),Bash(node *),Bash(curl *),Bash(ls *),Bash(find *)
CLAUDE_USE_CONTINUE=true
CLAUDE_SESSION_EXPIRY_HOURS=24
CLAUDE_MIN_VERSION=2.0.76
CLAUDE_AUTO_UPDATE=true
VERBOSE_PROGRESS=false
CB_COOLDOWN_MINUTES=5
CB_AUTO_RESET=true
MAX_CONSECUTIVE_TEST_LOOPS=3
MAX_CONSECUTIVE_DONE_SIGNALS=2
TEST_PERCENTAGE_THRESHOLD=30
ENABLE_NOTIFICATIONS=true
ENABLE_BACKUP=true
OPTIONAL_SECTIONS=Optional,Future,Nice to Have
