{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@engine/*": ["apps/engine/src/*"],
      "@trading/mexc-client": ["../../packages/mexc-client/src/index.ts"],
      "@trading/indodax-routes/routes.json": ["../../packages/indodax-routes/routes.json"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
